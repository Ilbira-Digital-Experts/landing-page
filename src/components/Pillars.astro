---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const icons = [
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 12l2 2 4-4M12 3a9 9 0 100 18A9 9 0 0012 3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
];

const content = {
  es: {
    label: 'Nuestros principios',
    heading: 'Tres principios detrás de cada recomendación que hacemos.',
    sub: 'No proponemos un agente porque se pueda construir. Lo proponemos cuando el punto de equilibrio entre coste y valor lo justifica — y lo mostramos con números, no con promesas.',
    items: [
      {
        title: 'Sabes exactamente cuánto cuesta cada agente.',
        body: 'Presupuesto máximo por proceso. Bloqueo automático al superarlo. Atribución clara: qué agente gasta qué, en qué modelo, para qué tarea. Si el punto de equilibrio no sale a cuenta, te lo decimos antes de construir nada.',
      },
      {
        title: 'La arquitectura y el conocimiento son tuyos.',
        body: 'Los procesos, excepciones y decisiones acumuladas viven en tu infraestructura, no en la nuestra. Con el tiempo, tus agentes se especializan tanto que dejan de depender de un proveedor concreto para esa tarea.',
      },
      {
        title: 'Cada decisión tiene una explicación.',
        body: 'Documentamos qué información usó el agente, qué comparó y por qué aprobó o escaló. No entregamos una caja negra. Entregamos un criterio auditable.',
      },
    ],
  },
  en: {
    label: 'Our principles',
    heading: 'Three principles behind every recommendation we make.',
    sub: "We don't propose an agent because it can be built. We propose it when the break-even between cost and value justifies it — and we show it with numbers, not promises.",
    items: [
      {
        title: 'You know exactly what each agent costs.',
        body: 'Maximum budget per process. Automatic cutoff when exceeded. Clear attribution: which agent spends what, on which model, for which task. If the break-even math doesn’t work, we tell you before building anything.',
      },
      {
        title: 'The architecture and the knowledge are yours.',
        body: "Accumulated processes, exceptions, and decisions live in your infrastructure, not ours. Over time your agents specialize enough that they stop depending on any single provider for that specific task.",
      },
      {
        title: 'Every decision has an explanation.',
        body: "We document what information the agent used, what it compared, and why it approved or escalated. We don't hand over a black box. We hand over an auditable judgment trail.",
      },
    ],
  },
}[lang];
---

<section class="py-24 lg:py-32 bg-white" id="metodo-principios" aria-labelledby="pilares-heading">
  <div class="section-container">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="section-label">{content.label}</p>
      <h2 id="pilares-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary mb-4">
        {content.heading}
      </h2>
      <p class="text-text-secondary text-lg">
        {content.sub}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {content.items.map((p, i) => (
        <article class="card p-7 flex flex-col gap-5 hover:shadow-md transition-shadow duration-200">
          <div class="flex items-center justify-between">
            <div class="w-11 h-11 rounded-xl bg-accent-dim text-accent flex items-center justify-center" set:html={icons[i]} />
            <span class="text-xs font-mono text-text-muted">{`0${i + 1}`}</span>
          </div>
          <div>
            <h3 class="text-base font-semibold text-text-primary mb-3 leading-snug">{p.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{p.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
