---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  es: {
    eyebrow: '[ Cuatro áreas ]',
    heading: 'Dónde actuamos',
    sub: 'No es un catálogo cerrado de servicios: es cómo solemos intervenir en cada área. Cada pilar agrupa varios servicios.',
    areas: [
      {
        title: 'Data Intelligence',
        body: 'Diagnóstico del estado de tus datos, arquitectura y analítica: la base sobre la que se sostiene cualquier proyecto de IA.',
      },
      {
        title: 'Seguridad y Cumplimiento de IA',
        body: 'Cumplimiento del AI Act, diagnóstico de Shadow AI y arquitectura segura para agentes en producción.',
      },
      {
        title: 'Gobernanza y Control de Coste',
        body: 'Auditoría, atribución de coste y operación continua. Nada de reventa de tokens: control real del gasto.',
      },
      {
        title: 'Formación',
        body: 'Formamos lo que construimos: sesiones ejecutivas y programas modulares para que el equipo use IA con criterio real.',
      },
    ],
    cta: 'Ver servicios',
  },
  en: {
    eyebrow: '[ Four areas ]',
    heading: 'Where we work',
    sub: "It's not a closed service catalog: it's how we usually intervene in each area. Each pillar groups several services.",
    areas: [
      {
        title: 'Data Intelligence',
        body: 'Diagnosing the state of your data, architecture, and analytics: the foundation any AI project stands on.',
      },
      {
        title: 'AI Security & Compliance',
        body: 'AI Act compliance, Shadow AI diagnostics, and secure architecture for agents in production.',
      },
      {
        title: 'Governance & Cost Control',
        body: "Audit, cost attribution, and ongoing operation. No token reselling — real control over your spend.",
      },
      {
        title: 'Training',
        body: 'We train what we build: executive sessions and modular programs so your team uses AI with real judgment.',
      },
    ],
    cta: 'See services',
  },
}[lang];
---

<section class="py-24 lg:py-32 bg-white" aria-labelledby="areas-heading">
  <div class="section-container">
    <div class="max-w-2xl mb-16">
      <p class="section-label">{content.eyebrow}</p>
      <h2 id="areas-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary mb-4">
        {content.heading}
      </h2>
      <p class="text-text-secondary text-base leading-relaxed">{content.sub}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {content.areas.map(area => (
        <a href={`/${lang}/que-hacemos`} class="card p-7 flex flex-col gap-4 hover:shadow-md transition-shadow duration-200 group">
          <h3 class="text-base font-semibold text-text-primary leading-snug group-hover:underline">{area.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed flex-1">{area.body}</p>
          <span class="text-xs font-medium text-accent inline-flex items-center gap-1">
            {content.cta}
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2.5 6h7M6 2.5L9.5 6 6 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
