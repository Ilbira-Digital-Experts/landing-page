---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const icons = [
  `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11 2L2 7v8l9 5 9-5V7L11 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M11 12a1 1 0 100-2 1 1 0 000 2zM11 8v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M11 7v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="3" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 8h16M8 3v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M11 13l2 2-2 2M9 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
];

const content = {
  es: {
    label: 'Con quién trabajamos',
    heading: 'Tres puntos de partida distintos. El mismo problema de fondo.',
    sub: 'No importa dónde estés hoy con la IA: reconocerás tu empresa en uno de estos tres perfiles.',
    items: [
      {
        title: 'No sabéis por dónde empezar.',
        body: 'Ya pagáis tokens que nadie controla del todo y la IA se ha colado en algún proceso, pero sin estrategia ni gobierno desde el día uno. Necesitáis un punto de partida claro.',
      },
      {
        title: 'Tenéis agentes en producción, pero sin control.',
        body: 'Los agentes ya deciden cosas todos los días. El problema es que nadie puede auditar por qué, ni atribuir qué coste genera cada uno. Os falta trazabilidad y gobernanza.',
      },
      {
        title: 'Sabéis lo que queréis, os falta ejecución.',
        body: 'Tenéis equipo de tecnología propio y un criterio claro de hacia dónde ir. Lo que necesitáis es una mano senior que arquitecture y construya con vosotros, no que os venda una caja negra.',
      },
    ],
  },
  en: {
    label: 'Who we work with',
    heading: 'Three different starting points. The same underlying problem.',
    sub: "No matter where you are with AI today, you'll recognize your company in one of these three profiles.",
    items: [
      {
        title: "You don't know where to start.",
        body: "You're already paying for tokens nobody fully controls, and AI has crept into some process without strategy or governance from day one. You need a clear starting point.",
      },
      {
        title: 'You have agents in production, but no control.',
        body: "Your agents already make decisions every day. The problem is no one can audit why, or attribute what each one costs. You're missing traceability and governance.",
      },
      {
        title: "You know what you want, you're missing execution.",
        body: 'You have your own tech team and a clear sense of direction. What you need is a senior hand to architect and build alongside you — not a black box sold to you.',
      },
    ],
  },
}[lang];
---

<section class="py-24 lg:py-32 bg-white" id="el-problema" aria-labelledby="problema-heading">
  <div class="section-container">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="section-label">{content.label}</p>
      <h2 id="problema-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary mb-4">
        {content.heading}
      </h2>
      <p class="text-text-secondary text-lg">
        {content.sub}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {content.items.map((p, i) => (
        <article class="card p-7 flex flex-col gap-4 hover:shadow-md transition-shadow duration-200">
          <div class="w-11 h-11 rounded-xl bg-bg-elevated border border-border flex items-center justify-center flex-shrink-0 text-text-secondary" set:html={icons[i]} />
          <h3 class="text-base font-semibold text-text-primary leading-snug">{p.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
