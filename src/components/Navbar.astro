---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { useUI, pathWithLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useUI(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const otherLangHref = pathWithLang(Astro.url.pathname, otherLang);

const links = [
  { label: t.nav.metodo, href: `/${lang}/metodo` },
  { label: t.nav.casos, href: `/${lang}/casos` },
  { label: t.nav.elMotor, href: `/${lang}/el-motor` },
  { label: t.nav.equipo, href: `/${lang}/equipo` },
];

const services = [
  { label: t.subnav.auditoria, href: `/${lang}/que-hacemos/auditoria-agentops` },
  { label: t.subnav.implementacion, href: `/${lang}/que-hacemos/implementacion-de-agentes` },
  { label: t.subnav.gestionado, href: `/${lang}/que-hacemos/agentops-gestionado` },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-30 transition-all duration-300"
>
  <div class="section-container">
    <nav class="flex items-center justify-between h-16" aria-label="Navegación principal">

      <!-- Logo -->
      <a href={`/${lang}`} class="flex items-center group flex-shrink-0" aria-label="Ilbira Digital Experts — inicio">
        <Image src={logo} alt="Ilbira Digital Experts" class="h-9 w-auto" widths={[100, 200]} />
      </a>

      <!-- Links desktop -->
      <div class="hidden lg:flex items-center gap-1">
        <div class="relative group/dropdown">
          <a
            href={`/${lang}/que-hacemos`}
            class="px-4 py-2 text-sm text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg-elevated transition-colors duration-150 inline-flex items-center gap-1"
          >
            {t.nav.queHacemos}
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="absolute left-0 top-full pt-1 hidden group-hover/dropdown:block focus-within:block">
            <ul class="min-w-[240px] bg-white border border-border rounded-xl shadow-lg p-2">
              {services.map(s => (
                <li>
                  <a href={s.href} class="block px-3 py-2 text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated rounded-lg transition-colors">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        {links.map(link => (
          <a
            href={link.href}
            class="px-4 py-2 text-sm text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg-elevated transition-colors duration-150"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Right side: lang switch + CTA + mobile toggle -->
      <div class="flex items-center gap-2">
        <a
          href={otherLangHref}
          hreflang={otherLang}
          lang={otherLang}
          aria-label={t.langSwitchLabel}
          class="hidden sm:inline-flex px-3 py-2 text-sm font-mono text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg-elevated transition-colors duration-150"
        >
          {otherLang.toUpperCase()}
        </a>

        <button
          data-cta="main"
          class="btn-primary hidden md:inline-flex px-4 py-2 text-sm"
        >
          {t.ctaShort}
        </button>

        <button
          id="mobile-menu-toggle"
          class="lg:hidden p-2.5 -mr-2 rounded-lg text-text-primary hover:bg-bg-elevated"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-border shadow-lg max-h-[calc(100vh-4rem)] overflow-y-auto">
    <div class="section-container py-4 flex flex-col gap-1">
      <p class="px-4 pt-2 pb-1 text-xs font-mono uppercase tracking-wider text-text-muted">{t.nav.queHacemos}</p>
      {services.map(s => (
        <a href={s.href} class="px-4 py-3 text-base text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg-elevated transition-colors">
          {s.label}
        </a>
      ))}
      <div class="h-px bg-border my-2"></div>
      {links.map(link => (
        <a href={link.href} class="px-4 py-3 text-base text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg-elevated transition-colors">
          {link.label}
        </a>
      ))}
      <div class="h-px bg-border my-2"></div>
      <a href={otherLangHref} hreflang={otherLang} lang={otherLang} class="px-4 py-3 text-base text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg-elevated transition-colors font-mono">
        {t.langSwitchTo} ({otherLang.toUpperCase()})
      </a>
      <button data-cta="main" class="btn-primary w-full py-3.5 text-base justify-center mt-2">
        {t.cta}
      </button>
    </div>
  </div>
</header>

<!-- Spacer for fixed nav -->
<div class="h-16"></div>

<script>
  // Scroll behavior: add glass/border on scroll
  const navbar = document.getElementById('navbar')!;
  const update = () => {
    const scrolled = window.scrollY > 20;
    navbar.classList.toggle('bg-white/90', scrolled);
    navbar.classList.toggle('backdrop-blur-md', scrolled);
    navbar.classList.toggle('border-b', scrolled);
    navbar.classList.toggle('border-border', scrolled);
    navbar.classList.toggle('shadow-sm', scrolled);
  };
  window.addEventListener('scroll', update, { passive: true });
  update();

  const BOOKING_URL = 'https://calendar.app.google/EGrDaNfbeRMD2y37A';

  document.querySelectorAll('[data-cta="main"]').forEach(btn => {
    btn.addEventListener('click', () => {
      window.open(BOOKING_URL, '_blank', 'noopener,noreferrer');
    });
  });

  document.querySelectorAll('[data-cta="core"]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-form', { detail: { kind: 'core' } }));
    });
  });

  // Mobile menu toggle
  const menuToggle = document.getElementById('mobile-menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  menuToggle.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden', isOpen);
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
  });
  mobileMenu.querySelectorAll('a, button').forEach(el => {
    el.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuToggle.setAttribute('aria-expanded', 'false');
    });
  });
</script>
