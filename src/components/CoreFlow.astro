---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  es: {
    label: 'Por dentro',
    heading: 'Cómo funciona Ilbira Core',
    sub: 'Así es como estructuramos internamente cada agente que arquitecturamos para un cliente.',
    steps: [
      {
        title: 'Describe',
        body: 'El proceso se especifica en lenguaje natural junto al equipo técnico del cliente. Sin nodos. Sin configuración previa.',
        fileLabel: 'proceso.txt',
        fileBody: '"Cuando llegue una factura de proveedor, valídala contra el pedido, comprueba el importe y aprueba si está dentro del umbral acordado."',
      },
      {
        title: 'Core genera y ejecuta',
        body: 'El motor genera los agentes necesarios y los pone a trabajar. Cuando no tienen confianza suficiente para decidir, preguntan antes de actuar.',
        rows: [
          { label: 'Validar importe', pct: 94, color: 'bg-success', status: '✓ Aprobado', statusCls: 'text-success' },
          { label: 'Verificar pedido', pct: 71, color: 'bg-warning', status: '✓ Aprobado', statusCls: 'text-warning' },
          { label: 'Límite de umbral', pct: 38, color: 'bg-danger', status: '⚠ Escalado', statusCls: 'text-danger' },
        ],
      },
      {
        title: 'Tú controlas',
        body: 'Ves en tiempo real qué hace cada agente, qué decidió, cuánto costó y dónde necesitó ayuda humana. La arquitectura y el conocimiento acumulado son tuyos.',
        panel: {
          header: 'Proceso: Facturas',
          status: '● activo',
          rows: [
            { k: 'Automatización', v: '89%', cls: 'text-success' },
            { k: 'Coste / transacc.', v: '€0.021', cls: 'text-text-primary' },
            { k: 'Decisiones hoy', v: '147', cls: 'text-text-primary' },
            { k: 'Escaladas', v: '12', cls: 'text-warning' },
            { k: 'Último evento', v: 'hace 2 min', cls: 'text-text-muted' },
          ],
        },
      },
    ],
    ctaLabel: 'Quiero más información',
    ctaHint: 'Sin coste. Solo lista de espera — Ilbira Core no se vende como producto todavía.',
  },
  en: {
    label: 'Under the hood',
    heading: 'How Ilbira Core works',
    sub: 'This is how we internally structure every agent we architect for a client.',
    steps: [
      {
        title: 'Describe',
        body: "The process is specified in natural language together with the client's technical team. No nodes. No upfront configuration.",
        fileLabel: 'process.txt',
        fileBody: '"When a supplier invoice arrives, validate it against the purchase order, check the amount, and approve if it\'s within the agreed threshold."',
      },
      {
        title: 'Core generates and runs it',
        body: "The engine generates the agents it needs and puts them to work. When they lack enough confidence to decide, they ask before acting.",
        rows: [
          { label: 'Validate amount', pct: 94, color: 'bg-success', status: '✓ Approved', statusCls: 'text-success' },
          { label: 'Verify order', pct: 71, color: 'bg-warning', status: '✓ Approved', statusCls: 'text-warning' },
          { label: 'Threshold limit', pct: 38, color: 'bg-danger', status: '⚠ Escalated', statusCls: 'text-danger' },
        ],
      },
      {
        title: 'You stay in control',
        body: "You see in real time what each agent is doing, what it decided, what it cost, and where it needed human help. The architecture and the accumulated knowledge are yours.",
        panel: {
          header: 'Process: Invoices',
          status: '● active',
          rows: [
            { k: 'Automation', v: '89%', cls: 'text-success' },
            { k: 'Cost / transaction', v: '€0.021', cls: 'text-text-primary' },
            { k: 'Decisions today', v: '147', cls: 'text-text-primary' },
            { k: 'Escalated', v: '12', cls: 'text-warning' },
            { k: 'Last event', v: '2 min ago', cls: 'text-text-muted' },
          ],
        },
      },
    ],
    ctaLabel: 'Request more info',
    ctaHint: "No cost. Waitlist only — Ilbira Core isn't sold as a product yet.",
  },
}[lang];
---

<section class="py-24 lg:py-32 bg-bg-secondary" id="como-funciona-motor" aria-labelledby="proceso-heading">
  <div class="section-container">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="section-label">{content.label}</p>
      <h2 id="proceso-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary mb-4">
        {content.heading}
      </h2>
      <p class="text-text-secondary text-lg">
        {content.sub}
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-0 relative">
      <!-- Connector line desktop -->
      <div class="hidden lg:block absolute top-8 left-[calc(16.66%+16px)] right-[calc(16.66%+16px)] h-px bg-border z-0"></div>

      <!-- Step 1 -->
      <div class="flex-1 flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <div class="relative z-10 w-8 h-8 rounded-full border border-accent/40 bg-accent/10 flex items-center justify-center text-xs font-mono font-semibold text-accent flex-shrink-0">
            01
          </div>
          <div class="lg:hidden h-px flex-1 bg-border"></div>
        </div>
        <div class="lg:pr-10">
          <h3 class="text-base font-semibold text-text-primary mb-2">{content.steps[0].title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed mb-5">
            {content.steps[0].body}
          </p>
          <div class="rounded-lg border border-border bg-bg-card p-4">
            <p class="text-xs font-mono text-text-muted mb-2">{content.steps[0].fileLabel}</p>
            <p class="text-sm text-text-secondary font-mono leading-relaxed">
              {content.steps[0].fileBody}
            </p>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex-1 flex flex-col gap-6 mt-10 lg:mt-0">
        <div class="flex items-center gap-4">
          <div class="relative z-10 w-8 h-8 rounded-full border border-accent/40 bg-accent/10 flex items-center justify-center text-xs font-mono font-semibold text-accent flex-shrink-0">
            02
          </div>
          <div class="lg:hidden h-px flex-1 bg-border"></div>
        </div>
        <div class="lg:px-5">
          <h3 class="text-base font-semibold text-text-primary mb-2">{content.steps[1].title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed mb-5">
            {content.steps[1].body}
          </p>
          <div class="rounded-lg border border-border bg-bg-card p-4 flex flex-col gap-3">
            {content.steps[1].rows.map(row => (
              <div class="flex flex-col gap-1.5">
                <div class="flex justify-between items-center">
                  <span class="text-xs text-text-secondary font-mono">{row.label}</span>
                  <span class={`text-xs font-mono ${row.statusCls}`}>{row.status}</span>
                </div>
                <div class="confidence-bar">
                  <div class={`confidence-bar-fill ${row.color}`} style={`width: ${row.pct}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex-1 flex flex-col gap-6 mt-10 lg:mt-0">
        <div class="flex items-center gap-4">
          <div class="relative z-10 w-8 h-8 rounded-full border border-accent/40 bg-accent/10 flex items-center justify-center text-xs font-mono font-semibold text-accent flex-shrink-0">
            03
          </div>
          <div class="lg:hidden h-px flex-1 bg-border"></div>
        </div>
        <div class="lg:pl-10">
          <h3 class="text-base font-semibold text-text-primary mb-2">{content.steps[2].title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed mb-5">
            {content.steps[2].body}
          </p>
          <div class="rounded-lg border border-border bg-bg-card p-4 font-mono text-xs">
            <div class="flex justify-between text-text-muted mb-3 pb-2 border-b border-border">
              <span>{content.steps[2].panel.header}</span>
              <span class="text-success">{content.steps[2].panel.status}</span>
            </div>
            {content.steps[2].panel.rows.map(row => (
              <div class="flex justify-between py-1">
                <span class="text-text-muted">{row.k}</span>
                <span class={row.cls}>{row.v}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-16 pt-10 border-t border-border text-center">
      <button
        class="btn-primary px-7 py-3 text-base"
        data-cta="core"
      >
        {content.ctaLabel}
      </button>
      <p class="text-xs text-text-muted mt-3">{content.ctaHint}</p>
    </div>
  </div>
</section>
