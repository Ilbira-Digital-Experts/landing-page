---
export const prerender = false;

import { getPostBySlug } from '../../../lib/posts';
import { type Lang } from '../../../i18n/ui';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import JsonLd from '../../../components/JsonLd.astro';
import SlideInForm from '../../../components/SlideInForm.astro';
import '../../../styles/global.css';

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const post = await getPostBySlug(slug, lang);

if (!post) {
  return Astro.redirect(`/${lang}/recursos`);
}

const { title, description, canonical, ogImage, publishedAt, updatedAt, author, tags, content } = post;
---

<Layout lang={lang} title={`${title} — Ilbira`} description={description} canonical={canonical} ogImage={ogImage}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: publishedAt.toISOString(),
      dateModified: (updatedAt ?? publishedAt).toISOString(),
      author: { '@type': 'Organization', name: author },
      keywords: tags.join(', '),
      inLanguage: lang,
      mainEntityOfPage: canonical ?? new URL(Astro.url.pathname, Astro.site).href,
    }}
  />

  <SlideInForm lang={lang} />
  <Navbar lang={lang} />
  <main class="section-container pt-40 pb-24 max-w-2xl mx-auto">
    <article>
      <header class="mb-10">
        <h1 class="text-3xl font-semibold text-text-primary">{title}</h1>
        <time datetime={publishedAt.toISOString()} class="text-xs font-mono text-text-muted mt-2 block">
          {publishedAt.toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </header>
      <div class="prose prose-neutral max-w-none" set:html={content} />
    </article>
  </main>
  <Footer lang={lang} />
</Layout>
