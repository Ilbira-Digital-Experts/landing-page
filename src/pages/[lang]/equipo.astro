---
import { langStaticPaths } from '../../i18n/paths';
import { type Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SlideInForm from '../../components/SlideInForm.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import '../../styles/global.css';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;

const content = {
  es: {
    title: 'Equipo — Ilbira',
    description: 'Fabián Almenara, fundador de Ilbira: arquitectura de agentes de IA con foco en observabilidad y control de coste.',
    eyebrow: 'Equipo',
    heading: 'Fabián Almenara',
    role: 'Fundador — Ilbira',
    bio: 'Fabián fundó Ilbira para resolver un problema muy concreto: la mayoría de implementaciones de agentes de IA se venden como cajas negras, sin forma de auditar el coste ni el criterio de decisión. Ilbira nace de aplicar disciplina de ingeniería —observabilidad, atribución de coste, trazabilidad— a un espacio que hasta ahora se ha vendido más como magia que como infraestructura.',
    linkLabel: 'Más sobre Fabián en fabianalmenara.es',
  },
  en: {
    title: 'Team — Ilbira',
    description: 'Fabián Almenara, founder of Ilbira: AI agent architecture with a focus on observability and cost control.',
    eyebrow: 'Team',
    heading: 'Fabián Almenara',
    role: 'Founder — Ilbira',
    bio: 'Fabián founded Ilbira to solve a very specific problem: most AI agent implementations are sold as black boxes, with no way to audit cost or decision judgment. Ilbira comes from applying engineering discipline — observability, cost attribution, traceability — to a space that has, until now, been sold more as magic than as infrastructure.',
    linkLabel: 'More about Fabián at fabianalmenara.es',
  },
}[lang];
---

<Layout lang={lang} title={content.title} description={content.description}>
  <SlideInForm lang={lang} />
  <Navbar lang={lang} />
  <main>
    <section class="pt-40 pb-24">
      <div class="section-container max-w-2xl">
        <p class="section-label">{content.eyebrow}</p>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary mb-1">{content.heading}</h1>
        <p class="text-sm font-mono text-text-muted mb-6">{content.role}</p>
        <p class="text-text-secondary text-base leading-relaxed mb-8">{content.bio}</p>
        <a
          href="https://fabianalmenara.es"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-text-primary hover:text-accent transition-colors underline underline-offset-4"
        >
          {content.linkLabel}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M2 10L10 2M10 2H5M10 2v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>
    <CtaBanner lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
